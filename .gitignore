# mise local overrides
mise.local.toml
mise.local.lock

# Pi sessions (may contain sensitive data)
sessions/

# Authentication files (never commit)
**/auth.json
**/credentials.json
**/env

# Comparison results are committed, but temporary files are not
comparison/results/*.tmp
comparison/results/*~ 

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
