# Example .env file for custom-providers profile.
# Copy to .env and fill in your API keys.
# NEVER commit .env to the repository.

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Synthetic (https://synthetic.new/settings)
SYNTHETIC_API_KEY=sk-synthetic-...

# Local LLM (Ollama) — no real key needed
# OLLAMA_HOST=localhost:11434

# NOTE: Do NOT set these if you want to disable built-in providers:
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# GOOGLE_API_KEY=...
# AWS_ACCESS_KEY_ID=...
