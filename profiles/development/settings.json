{
  "description": "Active coding. Medium thinking. File and search tools.",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-5",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "anthropic/claude-opus-4-1": "high"
  },
  "enabledTools": ["read", "edit", "bash", "glob", "grep"],
  "autoCompact": true,
  "compactThreshold": 0.75,
  "shell": {
    "timeout": 30000,
    "maxOutputLines": 200
  }
}
