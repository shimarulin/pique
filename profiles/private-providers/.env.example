# Example .env for private-providers profile.
# Copy to .env and fill in your values.
# NEVER commit .env to the repository.

# === Primary Provider ===
PROVIDER_PRIMARY_BASE_URL=https://your-primary-gateway.example.com/v1
PROVIDER_PRIMARY_API_KEY=sk-your-primary-key

# === Fallback Provider ===
PROVIDER_FALLBACK_BASE_URL=https://your-fallback-gateway.example.com/v1
PROVIDER_FALLBACK_API_KEY=sk-your-fallback-key

# === Primary Model ===
MODEL_PRIMARY_ID=claude-sonnet-4-5
MODEL_PRIMARY_CONTEXT_WINDOW=200000
MODEL_PRIMARY_MAX_TOKENS=64000
MODEL_PRIMARY_COST_INPUT=3
MODEL_PRIMARY_COST_OUTPUT=15

# === Secondary Model (optional) ===
MODEL_SECONDARY_ID=claude-opus-4-1
MODEL_SECONDARY_CONTEXT_WINDOW=200000
MODEL_SECONDARY_MAX_TOKENS=32000
MODEL_SECONDARY_COST_INPUT=15
MODEL_SECONDARY_COST_OUTPUT=75

# === Switching providers ===
# To use fallback as primary, swap the URL and KEY values.
# The models stay the same because they are the same models
# served by a different provider.

# === Disabling built-in providers ===
# Do NOT set these if you want to hide built-in provider models:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
