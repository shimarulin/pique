#!/usr/bin/env bash
set -euo pipefail

# pique — Launch Pi with a selected profile.
#
# Usage:
#   pique <profile> [pi-arguments...]
#   pique --list
#   pique --diff <a> <b>
#
# This script:
#   1. Resolves the profile directory.
#   2. Loads .env if present (profile or repository root).
#   3. Renders .template files if present.
#   4. Sets PI_CODING_AGENT_DIR.
#   5. Runs Pi in the current working directory.
#
# The repository can be located anywhere. This script resolves symlinks
# and finds the real repository root. Set PIQUE_ROOT to override.
#
# Project-level configuration (.pi/ in the current directory)
# continues to work. Project settings override profile settings.

# --- Resolve repository root ---

# Resolve the script location, following symlinks.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
DETECTED_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Allow override via environment variable PIQUE_ROOT.
# If not set, use the auto-detected repository root.
PIQUE_ROOT="${PIQUE_ROOT:-$DETECTED_ROOT}"

# Expand tilde (~) in PIQUE_ROOT if present.
# Bash does not expand ~ inside quoted variables or exports.
if [[ "$PIQUE_ROOT" == "~"* ]]; then
    PIQUE_ROOT="$HOME${PIQUE_ROOT#\~}"
fi

if [ ! -d "$PIQUE_ROOT" ]; then
    echo "Error: PIQUE_ROOT does not exist: $PIQUE_ROOT" >&2
    exit 1
fi

PROFILES_DIR="$PIQUE_ROOT/profiles"
SESSIONS_DIR="$PIQUE_ROOT/sessions"

if [ ! -d "$PROFILES_DIR" ]; then
    echo "Error: profiles directory not found: $PROFILES_DIR" >&2
    echo "" >&2
    echo "Repository root: $PIQUE_ROOT" >&2
    echo "Set PIQUE_ROOT to the correct location," >&2
    echo "or check your installation." >&2
    exit 1
fi

# --- Helper functions ---

# Load a .env file into the environment.
# Existing shell variables are never overwritten.
# Handles: KEY=value, comments (#), empty lines.
load_env_file() {
    local env_file="$1"
    [ -f "$env_file" ] || return 0

    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${key// /}" ]] && continue

        # Trim whitespace from key
        key="$(echo "$key" | xargs)"

        # Trim whitespace from value
        value="${value%\"}"
        value="${value#\"}"
        value="${value%\'}"
        value="${value#\'}"

        # Skip if already set in environment
        if [ -z "${!key:-}" ]; then
            export "$key=$value"
        fi
    done < "$env_file"
}

# Render a template file with environment variable substitution.
# Replaces ${VAR} and $VAR with values from the current environment.
# Requires perl or envsubst for substitution.
# Writes the result to the destination only if the content changed.
render_template() {
    local template="$1"
    local destination="$2"

    [ -f "$template" ] || return 1

    # Check we have a substitution tool
    if ! command -v perl >/dev/null 2>&1 && ! command -v envsubst >/dev/null 2>&1; then
        echo "Error: Cannot render template $template" >&2
        echo "Neither perl nor envsubst is available." >&2
        echo "Install one of them, or create $destination manually." >&2
        return 1
    fi

    local rendered

    if command -v envsubst >/dev/null 2>&1; then
        # envsubst handles both $VAR and ${VAR}
        rendered="$(envsubst < "$template")"
    else
        # perl handles both $VAR and ${VAR}
        rendered="$(perl -pe '
            s/\$\{([A-Za-z_][A-Za-z0-9_]*)\}/$ENV{$1} \/\/ ""/ge;
            s/\$([A-Za-z_][A-Za-z0-9_]*)/$ENV{$1} \/\/ ""/ge;
        ' "$template")"
    fi

    # Write only if changed
    if [ ! -f "$destination" ] || ! diff -q <(echo "$rendered") "$destination" >/dev/null 2>&1; then
        echo "$rendered" > "$destination"
        return 0  # File was updated
    fi
    return 1  # No changes
}

# Render profile templates if template files exist.
# Template files: *.template (e.g., models.json.template, settings.json.template)
# Rendered to: the same name without .template suffix.
render_profile_templates() {
    local profile_dir="$1"
    local updated=false

    # Find all .template files in the profile directory
    for template in "$profile_dir"/*.template; do
        [ -f "$template" ] || continue

        # Derive destination name
        local destination="${template%.template}"

        if render_template "$template" "$destination"; then
            updated=true
            echo "Rendered: $(basename "$destination")" >&2
        fi
    done

    # If any file was rendered, print a note
    if [ "$updated" = true ]; then
        echo "" >&2
        echo "Profile configuration rendered from templates." >&2
        echo "Templates are in the profile directory (.template suffix)." >&2
        echo "Set environment variables before running pique to customize." >&2
    fi
}

get_profile_description() {
    local settings_file="$1"
    python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    desc = d.get('description', '')
    print(desc if desc else '(no description)')
except Exception:
    print('(no description)')
" "$settings_file" 2>/dev/null || echo "(no description)"
}

list_profiles() {
    echo "Available profiles:"
    echo ""
    for dir in "$PROFILES_DIR"/*/; do
        [ -d "$dir" ] || continue
        local name
        name="$(basename "$dir")"
        local desc
        if [ -f "$dir/settings.json" ]; then
            desc="$(get_profile_description "$dir/settings.json")"
        elif [ -f "$dir/settings.json.template" ]; then
            desc="(template, needs rendering)"
        else
            desc="(no settings.json)"
        fi
        printf "  %-16s %s\\n" "$name" "$desc"
    done
}

diff_profiles() {
    if [ $# -lt 2 ]; then
        echo "Usage: pique --diff <profile-a> <profile-b>" >&2
        echo "" >&2
        echo "Example:" >&2
        echo "  pique --diff minimal development" >&2
        exit 1
    fi

    local a="$1"
    local b="$2"
    local dir_a="$PROFILES_DIR/$a"
    local dir_b="$PROFILES_DIR/$b"

    if [ ! -d "$dir_a" ]; then
        echo "Error: profile '$a' not found." >&2
        echo "Searched: $dir_a" >&2
        exit 1
    fi
    if [ ! -d "$dir_b" ]; then
        echo "Error: profile '$b' not found." >&2
        echo "Searched: $dir_b" >&2
        exit 1
    fi

    echo "=== $a <-> $b ==="
    echo ""

    # Exclude rendered files and .env from diff
    diff -ru \
        --exclude="*.json" \
        --exclude=".env" \
        --exclude="auth.json" \
        --exclude="sessions" \
        "$dir_a" "$dir_b" || true

    # Diff templates separately (they are the source of truth)
    echo "--- Template files ---"
    for template_a in "$dir_a"/*.template; do
        [ -f "$template_a" ] || continue
        local name
        name="$(basename "$template_a")"
        local template_b="$dir_b/$name"
        if [ -f "$template_b" ]; then
            diff -u "$template_a" "$template_b" || true
        else
            echo "Only in $a: $name"
        fi
    done
    for template_b in "$dir_b"/*.template; do
        [ -f "$template_b" ] || continue
        local name
        name="$(basename "$template_b")"
        local template_a="$dir_a/$name"
        if [ ! -f "$template_a" ]; then
            echo "Only in $b: $name"
        fi
    done
}

show_help() {
    cat <<EOF
pique — Launch Pi with a selected profile

Usage:
  pique <profile> [pi-arguments...]   Launch Pi with profile
  pique --list                        List available profiles
  pique --diff <a> <b>                Compare two profiles
  pique --help                        Show this help

Profiles directory: $PROFILES_DIR
Repository: $PIQUE_ROOT

Environment variables:
  PIQUE_ROOT                          Override repository root
  PI_CODING_AGENT_DIR                 Set by this script, points to profile
  PI_CODING_AGENT_SESSION_DIR         Set if sessions directory exists

Profile features:
  .env                                Loaded before Pi starts
  *.template                          Rendered with env vars before Pi starts
  models.json                         Pi provider definitions
  settings.json                       Pi settings (or settings.json.template)

Examples:
  pique development                   Start Pi with development profile
  pique research --print "Analyze"    Start Pi with research profile, print mode
  pique minimal --version             Check Pi version with minimal profile
  pique --diff minimal development    Compare two profiles
  pique --list                        Show available profiles
EOF
}

# --- Argument parsing ---

if [ $# -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "--list" ] || [ "$1" = "-l" ]; then
    list_profiles
    exit 0
fi

if [ "$1" = "--diff" ]; then
    shift
    diff_profiles "$@"
    exit 0
fi

if [ "$1" = "--version" ] || [ "$1" = "-V" ]; then
    echo "pique (from $PIQUE_ROOT)"
    if command -v pi >/dev/null 2>&1; then
        pi --version 2>/dev/null || true
    fi
    exit 0
fi

# --- Launch with profile ---

PROFILE_NAME="$1"
PROFILE_DIR="$PROFILES_DIR/$PROFILE_NAME"

if [ ! -d "$PROFILE_DIR" ]; then
    echo "Error: profile '$PROFILE_NAME' not found." >&2
    echo "Searched: $PROFILE_DIR" >&2
    echo "" >&2
    list_profiles >&2
    exit 1
fi

shift  # Remove profile name from arguments

# --- Load environment ---

# Load .env from the profile directory first (takes priority)
load_env_file "$PROFILE_DIR/.env"

# Load .env from the pique root as fallback (if profile has none)
if [ ! -f "$PROFILE_DIR/.env" ] && [ -f "$PIQUE_ROOT/.env" ]; then
    load_env_file "$PIQUE_ROOT/.env"
fi

# --- Render templates ---

render_profile_templates "$PROFILE_DIR"

# --- Set environment ---

export PI_CODING_AGENT_DIR="$PROFILE_DIR"

# Set sessions directory if it exists or if the sessions root exists.
# This keeps session data separate between profiles.
PROFILE_SESSIONS="$SESSIONS_DIR/$PROFILE_NAME"
if [ -d "$PROFILE_SESSIONS" ] || [ -d "$SESSIONS_DIR" ]; then
    mkdir -p "$PROFILE_SESSIONS"
    export PI_CODING_AGENT_SESSION_DIR="$PROFILE_SESSIONS"
fi

# --- Resolve Pi binary ---

PI_BIN=""

# Try mise from the pique repository (if mise is available and root exists)
if command -v mise >/dev/null 2>&1 && [ -f "$PIQUE_ROOT/mise.toml" ]; then
    PI_BIN="$(cd "$PIQUE_ROOT" 2>/dev/null && mise which pi 2>/dev/null || true)"
fi

# Fallback to system PATH
if [ -z "$PI_BIN" ] || [ ! -x "$PI_BIN" ]; then
    PI_BIN="$(command -v pi 2>/dev/null || true)"
fi

if [ -z "$PI_BIN" ]; then
    echo "Error: 'pi' binary not found." >&2
    echo "" >&2
    echo "Install Pi via mise (recommended):" >&2
    echo "  cd $PIQUE_ROOT" >&2
    echo "  mise install" >&2
    echo "" >&2
    echo "Or install globally:" >&2
    echo "  curl -fsSL https://pi.dev/install.sh | sh" >&2
    echo "" >&2
    echo "Or add pi to your PATH." >&2
    exit 1
fi

# --- Launch Pi ---

exec "$PI_BIN" "$@"
